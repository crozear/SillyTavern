ignore-scripts=true
min-release-age=7
# Every launcher (Start.bat, UpdateAndStart.bat, UpdateForkAndStart.bat) runs
# `npm install --omit=dev`, which does not merely skip devDependencies — it prunes
# them back out of node_modules on every start. That silently uninstalled eslint
# after each launch. npm resolves a package type present in both `include` and
# `omit` as included, so this line neutralises the launchers' `--omit=dev`.
include=dev
